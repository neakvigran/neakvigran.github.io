#!/usr/bin/env bash
set -euo pipefail

VAULT="${OBSIDIAN_VAULT:-$HOME/Obsidian Vault}"
REPO="${CHIRPY_REPO:-$VAULT/neakvigran.github.io}"
PUBLISHER="$REPO/tools/publish_obsidian.py"
MANIFEST="$REPO/tools/.obsidian-published.json"

usage() {
  cat <<'HELP'
Usage:
  publish-writeup "Platform/Category/Note.md" [options]
  publish-writeup --batch "note1.md" "note2.md" ... [options]
  publish-writeup --folder "Platform/Category" [options]

Options:
  --write              Generate/update local files only
  --deploy             Preview, confirm, validate, commit and push
  --tags TAGS          Override tags for selected notes
  --platform NAME      Override platform
  --category NAME      Override category
  --recursive          Include subfolders with --folder
  -h, --help           Show this help

Default: preview only.

Environment:
  OBSIDIAN_VAULT
  CHIRPY_REPO
HELP
}

die() {
  echo "Error: $*" >&2
  exit 1
}

MODE=single
WRITE=false
DEPLOY=false
RECURSIVE=false
FOLDER=""
OVERRIDE_PLATFORM=""
OVERRIDE_CATEGORY=""
OVERRIDE_TAGS=""
NOTES=()

while (($#)); do
  case "$1" in
    --batch)
      [[ "$MODE" == single && ${#NOTES[@]} -eq 0 ]] ||
        die "Choose only one publishing mode."
      MODE=batch
      shift
      ;;
    --folder)
      [[ "$MODE" == single && ${#NOTES[@]} -eq 0 && $# -ge 2 ]] ||
        die "--folder requires a directory."
      MODE=folder
      FOLDER="$2"
      shift 2
      ;;
    --write)
      WRITE=true
      shift
      ;;
    --deploy)
      DEPLOY=true
      shift
      ;;
    --recursive)
      RECURSIVE=true
      shift
      ;;
    --platform|--category|--tags)
      (($# >= 2)) || die "$1 requires a value."
      case "$1" in
        --platform) OVERRIDE_PLATFORM="$2" ;;
        --category) OVERRIDE_CATEGORY="$2" ;;
        --tags) OVERRIDE_TAGS="$2" ;;
      esac
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      die "Unknown option: $1"
      ;;
    *)
      [[ "$MODE" != folder ]] ||
        die "Unexpected note after --folder."
      NOTES+=("$1")
      shift
      ;;
  esac
done

if [[ "$DEPLOY" == true && "$WRITE" == true ]]; then
  die "--deploy and --write cannot be combined."
fi

if [[ "$RECURSIVE" == true && "$MODE" != folder ]]; then
  die "--recursive requires --folder."
fi

[[ -d "$VAULT" ]] || die "Vault not found: $VAULT"
[[ -d "$REPO" ]] || die "Repository not found: $REPO"
[[ -f "$PUBLISHER" ]] || die "Publisher missing: $PUBLISHER"

VAULT="$(realpath "$VAULT")"
REPO="$(realpath "$REPO")"

if [[ "$MODE" == folder ]]; then
  if [[ "$FOLDER" == /* ]]; then
    DIR="$FOLDER"
  else
    DIR="$VAULT/$FOLDER"
  fi

  [[ -d "$DIR" ]] || die "Folder not found: $DIR"
  DIR="$(realpath "$DIR")"

  case "$DIR/" in
    "$VAULT/"*) ;;
    *) die "Folder must be inside the vault." ;;
  esac

  case "$DIR/" in
    "$REPO/"*) die "Cannot publish repository files." ;;
  esac

  if [[ "$RECURSIVE" == true ]]; then
    mapfile -d '' -t NOTES < <(
      find "$DIR" -type f -name '*.md' -print0 | sort -z
    )
  else
    mapfile -d '' -t NOTES < <(
      find "$DIR" -maxdepth 1 -type f -name '*.md' -print0 | sort -z
    )
  fi
fi

if [[ "$MODE" == single && ${#NOTES[@]} -ne 1 ]] ||
   [[ "$MODE" == batch && ${#NOTES[@]} -eq 0 ]]; then
  usage
  exit 2
fi

if ((${#NOTES[@]} == 0)); then
  echo "No Markdown notes found."
  exit 0
fi

RESOLVED=()
declare -A SEEN=()

for note in "${NOTES[@]}"; do
  if [[ "$note" == /* ]]; then
    source="$note"
  else
    source="$VAULT/$note"
  fi

  [[ -f "$source" ]] || die "Note not found: $source"
  source="$(realpath "$source")"

  case "$source" in
    "$VAULT/"*) ;;
    *) die "Note is outside the vault: $source" ;;
  esac

  case "$source" in
    "$REPO/"*) die "Cannot publish repository source files." ;;
  esac

  [[ "$source" == *.md ]] || die "Not a Markdown note: $source"

  if [[ -z "${SEEN[$source]+x}" ]]; then
    RESOLVED+=("$source")
    SEEN[$source]=1
  fi
done

PLAN="$(mktemp)"
trap 'rm -f "$PLAN"' EXIT

python3 - "$VAULT" "$REPO" "$MANIFEST" \
  "${RESOLVED[@]}" > "$PLAN" <<'PY'
import json
import pathlib
import re
import sys

vault, repo, manifest = map(pathlib.Path, sys.argv[1:4])
sources = list(map(pathlib.Path, sys.argv[4:]))

try:
    records = (
        json.loads(manifest.read_text(encoding="utf-8"))
        if manifest.exists()
        else {}
    )
    if not isinstance(records, dict):
        raise ValueError("Manifest must be an object")
except (ValueError, OSError) as exc:
    sys.exit(f"Invalid manifest: {exc}")

planned = {}

for source in sources:
    key = source.relative_to(vault).as_posix()
    entry = records.get(key)

    if entry is not None and not isinstance(entry, dict):
        sys.exit(f"Invalid manifest record: {key}")

    operation = "update" if entry is not None else "publish"
    slug = (
        entry["slug"]
        if entry is not None
        else re.sub(r"[^a-z0-9]+", "-", source.stem.lower()).strip("-")
    )

    if not slug:
        sys.exit(f"Invalid slug: {key}")

    if slug in planned and planned[slug] != key:
        sys.exit(f"Slug collision: {key} and {planned[slug]}")

    planned[slug] = key

    if operation == "publish":
        matches = list((repo / "_posts").glob(f"*-{slug}.md"))
        if matches:
            sys.exit(f"Post already exists: {matches[0]}")

    print(operation + "\t" + str(source))
PY

TOTAL=${#RESOLVED[@]}

run_publisher() {
  local write_mode="$1"
  local plan_file="${2:-$PLAN}"
  local failed=0
  local succeeded=0
  local operation source rel platform category remainder
  local -a args

  while IFS=$'\t' read -r operation source; do
    rel="${source#"$VAULT"/}"
    platform="${rel%%/*}"
    remainder="${rel#*/}"

    if [[ "$remainder" == */* ]]; then
      category="${remainder%%/*}"
    else
      category="General"
    fi

    [[ -z "$OVERRIDE_PLATFORM" ]] ||
      platform="$OVERRIDE_PLATFORM"

    [[ -z "$OVERRIDE_CATEGORY" ]] ||
      category="$OVERRIDE_CATEGORY"

    args=(
      "$operation"
      "$source"
      --platform "$platform"
      --category "$category"
    )

    [[ -z "$OVERRIDE_TAGS" ]] ||
      args+=(--tags "$OVERRIDE_TAGS")

    [[ "$write_mode" == false ]] ||
      args+=(--write)

    printf '\n[%s] %s\n' "$operation" "$rel"

    if (cd "$REPO" && python3 "$PUBLISHER" "${args[@]}"); then
      ((succeeded+=1))
    else
      ((failed+=1))
      echo "FAILED: $rel" >&2
    fi
  done < "$plan_file"

  printf '\nSummary: %d succeeded, %d failed, %d processed\n' \
    "$succeeded" "$failed" "$((succeeded + failed))"

  ((failed == 0))
}

if [[ "$DEPLOY" == false ]]; then
  echo "Mode: $MODE | Notes: $TOTAL | $(
    [[ "$WRITE" == true ]] && echo WRITE || echo PREVIEW
  )"
  echo "--------------------------------------------------"

  run_publisher "$WRITE"

  if [[ "$WRITE" == true ]]; then
    echo "Local files only. Nothing committed or pushed."
  fi

  exit 0
fi


# =========================================
# FINGERPRINT VERIFICATION
# =========================================

VERIFIER="$REPO/tools/verify_writeup.py"

verify_generated_writeups() {
  [[ -f "$VERIFIER" ]] ||
    die "Fingerprint verifier missing: $VERIFIER"

  echo
  echo "Verifying generated writeup fingerprints..."

  python3 "$VERIFIER" "${RESOLVED[@]}" ||
    die "Fingerprint verification failed. Regenerate stale notes with --write."

  echo "PASS: Selected writeups match their recorded fingerprints."
}

# =========================================
# MANIFEST ISOLATION VERIFICATION
# =========================================

MANIFEST_VERIFIER="$REPO/tools/verify_manifest.py"

verify_manifest_changes() {
  [[ -f "$MANIFEST_VERIFIER" ]] ||
    die "Manifest verifier missing: $MANIFEST_VERIFIER"

  echo
  echo "Checking publishing manifest isolation..."

  python3 "$MANIFEST_VERIFIER" "${RESOLVED[@]}" ||
    die "Manifest contains unrelated changes. Deployment cancelled."

  echo "PASS: Manifest changes belong only to selected writeups."
}

# =========================================
# DEPLOY MODE
# =========================================

command -v git >/dev/null || die "Git is not installed."
command -v bundle >/dev/null || die "Bundler is not installed."

cd "$REPO"

[[ "$(git branch --show-current)" == main ]] ||
  die "Deployment requires the main branch."

git remote get-url origin >/dev/null ||
  die "Git remote origin is missing."

# Allow previously generated writeup files.
# Never deploy with pre-existing staged changes.
[[ -z "$(git diff --cached --name-only)" ]] ||
  die "Git index contains staged changes. Review or unstage them first."

# Refuse unresolved merge conflicts.
[[ -z "$(git ls-files -u)" ]] ||
  die "Unresolved Git merge conflicts detected."

echo "Checking GitHub synchronization..."

git fetch origin main

LOCAL_HEAD="$(git rev-parse HEAD)"
REMOTE_HEAD="$(git rev-parse refs/remotes/origin/main)"

[[ "$LOCAL_HEAD" == "$REMOTE_HEAD" ]] ||
  die "Local main differs from origin/main. Synchronize before deployment."

echo
echo "========================================"
echo " WRITEUPS DEPLOYMENT PREVIEW"
echo "========================================"
echo "Mode: $MODE"
echo "Notes: $TOTAL"
echo

run_publisher false ||
  die "Preview failed. Deployment cancelled."

echo
echo "Before publishing, confirm that:"
echo "- All selected rooms permit public walkthroughs."
echo "- Screenshots contain no unintended private information."
echo "- Commands, links, and metadata have been reviewed."
echo "- You intend to publish all $TOTAL selected notes."
echo

read -r -p "Continue with local generation? [y/N]: " answer

[[ "$answer" == y || "$answer" == Y ]] || {
  echo "Deployment cancelled."
  exit 0
}

echo
echo "Checking generated writeups..."

# Validate manifest changes before any generation.
verify_manifest_changes

# Separate already generated notes from notes requiring generation.
PREPARED=()
TO_GENERATE=()

while IFS=$'\t' read -r operation source; do
  rel="${source#"$VAULT"/}"

  if python3 - "$MANIFEST" "$rel" <<'PYCHECK'
import json
import sys
from pathlib import Path

manifest = json.loads(
    Path(sys.argv[1]).read_text(encoding="utf-8")
)
entry = manifest.get(sys.argv[2])

required = ("source_sha256", "post_sha256", "image_sha256")

if isinstance(entry, dict) and all(k in entry for k in required):
    sys.exit(0)

sys.exit(1)
PYCHECK
  then
    PREPARED+=("$source")
  else
    TO_GENERATE+=("$source")
  fi
done < "$PLAN"

if ((${#PREPARED[@]} > 0)); then
  echo "Verifying previously generated writeups..."

  python3 "$VERIFIER" "${PREPARED[@]}" ||
    die "Prepared writeup verification failed. Run --write again."
fi

if ((${#TO_GENERATE[@]} > 0)); then
  echo "Generating notes without fingerprints..."

  # Existing registered posts without fingerprints must be
  # regenerated explicitly using --write.
  for source in "${TO_GENERATE[@]}"; do
    rel="${source#"$VAULT"/}"

    if python3 - "$MANIFEST" "$rel" <<'PYCHECK'
import json
import sys
from pathlib import Path

manifest = json.loads(
    Path(sys.argv[1]).read_text(encoding="utf-8")
)

sys.exit(0 if sys.argv[2] in manifest else 1)
PYCHECK
    then
      die "Existing writeup lacks fingerprints: $rel. Run --write first."
    fi
  done

  # New notes are generated by the existing publisher.
  # Generate only notes that have not been prepared.
GENERATE_PLAN="$(mktemp)"

for source in "${TO_GENERATE[@]}"; do
  printf 'publish\t%s\n' "$source" >> "$GENERATE_PLAN"
done

if ! run_publisher true "$GENERATE_PLAN"; then
  rm -f "$GENERATE_PLAN"
  die "Generation failed. Review local changes."
fi

rm -f "$GENERATE_PLAN"
fi

verify_generated_writeups
verify_manifest_changes

echo
echo "Building generated website..."

bundle exec jekyll build ||
  die "Jekyll build failed."

# Identify generated post paths and image directories
# using the updated manifest.
mapfile -d '' -t GENERATED < <(
  python3 - "$VAULT" "$MANIFEST" \
    "${RESOLVED[@]}" <<'PY'
import json
import pathlib
import sys

vault = pathlib.Path(sys.argv[1])
manifest_path = pathlib.Path(sys.argv[2])
sources = list(map(pathlib.Path, sys.argv[3:]))

manifest = json.loads(
    manifest_path.read_text(encoding="utf-8")
)

paths = set()

for source in sources:
    key = source.relative_to(vault).as_posix()
    entry = manifest[key]

    paths.add(entry["post"])

    for name in entry["images"]:
        paths.add(
            f"assets/img/obsidian/{entry['slug']}/{name}"
        )

for path in sorted(paths):
    sys.stdout.buffer.write(path.encode() + b"\0")
PY
)

git add -- "${GENERATED[@]}"
git add -- tools/.obsidian-published.json

# Verify that only selected posts, registered images,
# and the publishing manifest are staged.
python3 - "$VAULT" "$MANIFEST" "${RESOLVED[@]}" <<'PYVALIDATE'
import json
import pathlib
import subprocess
import sys

vault = pathlib.Path(sys.argv[1])
manifest_path = pathlib.Path(sys.argv[2])
sources = [pathlib.Path(p) for p in sys.argv[3:]]

manifest = json.loads(
    manifest_path.read_text(encoding="utf-8")
)

allowed = {"tools/.obsidian-published.json"}

for source in sources:
    key = source.relative_to(vault).as_posix()
    entry = manifest[key]

    allowed.add(entry["post"])
    allowed.update(
        f"assets/img/obsidian/{entry['slug']}/{name}"
        for name in entry["images"]
    )

staged = subprocess.check_output(
    ["git", "diff", "--cached", "--name-only", "-z"]
).decode("utf-8").split("\0")

unexpected = [
    name for name in staged
    if name and name not in allowed
]

if unexpected:
    sys.exit(
        "Unexpected staged files:\n"
        + "\n".join(unexpected)
    )

print("PASS: Only selected writeup files are staged.")
PYVALIDATE

echo
echo "Staged changes:"
git diff --cached --stat

# Allow Markdown's intentional trailing spaces, but
# still reject other Git whitespace errors.
git -c core.whitespace=-blank-at-eol,-blank-at-eof \
  diff --cached --check ||
  die "Staged changes failed validation."

if git diff --cached --quiet; then
  echo "No changes to publish."
  exit 0
fi

echo
read -r -p "Commit and push these changes to GitHub? [y/N]: " answer

[[ "$answer" == y || "$answer" == Y ]] || {
  echo "Changes generated locally but not committed or pushed."
  exit 0
}

git commit -m "Publish $TOTAL cybersecurity writeup(s)"

# Recheck the remote before pushing.
git fetch origin main

[[ "$(git rev-parse HEAD^)" == \
   "$(git rev-parse refs/remotes/origin/main)" ]] ||
  die "Remote changed during deployment. Commit retained locally; push cancelled."

git push origin main

echo
echo "========================================"
echo " Deployment push completed"
echo "========================================"
echo "Check GitHub Actions for the Pages build."
echo "Website: https://neakvigran.github.io"
