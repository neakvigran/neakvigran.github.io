#!/usr/bin/env bash
set -euo pipefail

VAULT="${OBSIDIAN_VAULT:-$HOME/Obsidian Vault}"
REPO="${CHIRPY_REPO:-$VAULT/neakvigran.github.io}"
PUBLISHER="$REPO/tools/publish_obsidian.py"
MANIFEST="$REPO/tools/.obsidian-published.json"

usage() {
  cat <<'HELP'
Usage:
  publish-writeup "Platform/Category/Note.md" [--write] [--tags TAGS]
  publish-writeup --batch "note1.md" "note2.md" ... [--write]
  publish-writeup --folder "Platform/Category" [--write]
Options:
  --write              Generate/update local files (default: preview)
  --tags TAGS          Override tags for all selected notes
  --platform NAME      Override platform for all selected notes
  --category NAME      Override category for all selected notes
  --recursive          With --folder, include subfolders
  -h, --help           Show this help
Environment: OBSIDIAN_VAULT, CHIRPY_REPO
HELP
}

MODE=single
WRITE=false
RECURSIVE=false
FOLDER=""
OVERRIDE_PLATFORM=""
OVERRIDE_CATEGORY=""
OVERRIDE_TAGS=""
NOTES=()

while (($#)); do
  case "$1" in
    --batch)
      [[ "$MODE" == single && ${#NOTES[@]} -eq 0 ]] || { echo 'Error: choose one mode.' >&2; exit 2; }
      MODE=batch; shift ;;
    --folder)
      [[ "$MODE" == single && ${#NOTES[@]} -eq 0 && $# -ge 2 ]] || { echo 'Error: --folder requires a directory and cannot be combined with --batch.' >&2; exit 2; }
      MODE=folder; FOLDER="$2"; shift 2 ;;
    --write) WRITE=true; shift ;;
    --recursive) RECURSIVE=true; shift ;;
    --platform|--category|--tags)
      (($# >= 2)) || { echo "Error: $1 requires a value." >&2; exit 2; }
      case "$1" in
        --platform) OVERRIDE_PLATFORM="$2" ;;
        --category) OVERRIDE_CATEGORY="$2" ;;
        --tags) OVERRIDE_TAGS="$2" ;;
      esac
      shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --*) echo "Unknown option: $1" >&2; usage; exit 2 ;;
    *) [[ "$MODE" != folder ]] || { echo 'Error: unexpected note after --folder.' >&2; exit 2; }
       NOTES+=("$1"); shift ;;
  esac
done

[[ -f "$PUBLISHER" ]] || { echo "Publisher missing: $PUBLISHER" >&2; exit 1; }
[[ -d "$VAULT" ]] || { echo "Vault missing: $VAULT" >&2; exit 1; }
if [[ "$MODE" == single && ${#NOTES[@]} -ne 1 ]] || [[ "$MODE" == batch && ${#NOTES[@]} -eq 0 ]]; then
  usage; exit 2
fi
if [[ "$RECURSIVE" == true && "$MODE" != folder ]]; then
  echo 'Error: --recursive is only valid with --folder.' >&2; exit 2
fi

VAULT="$(realpath "$VAULT")"
REPO="$(realpath "$REPO")"

if [[ "$MODE" == folder ]]; then
  if [[ "$FOLDER" == /* ]]; then DIR="$FOLDER"; else DIR="$VAULT/$FOLDER"; fi
  [[ -d "$DIR" ]] || { echo "Folder not found: $DIR" >&2; exit 1; }
  DIR="$(realpath "$DIR")"
  case "$DIR/" in "$VAULT/"*) ;; *) echo 'Error: folder must be inside vault.' >&2; exit 1;; esac
  case "$DIR/" in "$REPO/"*) echo 'Error: website repository cannot be used as source.' >&2; exit 1;; esac
  if [[ "$RECURSIVE" == true ]]; then
    mapfile -d '' -t NOTES < <(find "$DIR" -type f -name '*.md' -print0 | sort -z)
  else
    mapfile -d '' -t NOTES < <(find "$DIR" -maxdepth 1 -type f -name '*.md' -print0 | sort -z)
  fi
fi

if ((${#NOTES[@]} == 0)); then echo 'No Markdown notes found.'; exit 0; fi

# Resolve and validate every note before any write. Deduplicate repeated paths.
RESOLVED=()
declare -A SEEN=()
for note in "${NOTES[@]}"; do
  if [[ "$note" == /* ]]; then source="$note"; else source="$VAULT/$note"; fi
  [[ -f "$source" ]] || { echo "Note not found: $source" >&2; exit 1; }
  source="$(realpath "$source")"
  case "$source" in "$VAULT/"*) ;; *) echo "Outside vault: $source" >&2; exit 1;; esac
  case "$source" in "$REPO/"*) echo "Cannot publish website source: $source" >&2; exit 1;; esac
  [[ "$source" == *.md ]] || { echo "Not Markdown: $source" >&2; exit 1; }
  if [[ -z "${SEEN[$source]+x}" ]]; then RESOLVED+=("$source"); SEEN[$source]=1; fi
done

# Read manifest with Python, reject malformed manifest and detect existing post collisions.
PLAN="$(mktemp)"
trap 'rm -f "$PLAN"' EXIT
python3 - "$VAULT" "$REPO" "$MANIFEST" "${RESOLVED[@]}" > "$PLAN" <<'PY'
import json,sys,pathlib,re
vault,repo,manifest=map(pathlib.Path,sys.argv[1:4]); sources=list(map(pathlib.Path,sys.argv[4:]))
try:
    records=json.loads(manifest.read_text(encoding='utf-8')) if manifest.exists() else {}
    if not isinstance(records,dict): raise ValueError('manifest must be a JSON object')
except (ValueError,OSError) as e:
    sys.exit(f'Invalid manifest: {e}')
planned={}
for source in sources:
    key=source.relative_to(vault).as_posix()
    entry=records.get(key)
    if entry is not None and not isinstance(entry,dict): sys.exit(f'Invalid manifest record for {key}')
    mode='update' if entry is not None else 'publish'
    slug=re.sub(r'[^a-z0-9]+','-',source.stem.lower()).strip('-')
    if not slug: sys.exit(f'Invalid slug for {key}')
    # Guard against same-slug image directory collisions across notes.
    if slug in planned and planned[slug]!=key:
        sys.exit(f'Slug collision: {planned[slug]} and {key}')
    planned[slug]=key
    if mode=='publish':
        existing=list((repo/'_posts').glob(f'*-{slug}.md'))
        if existing: sys.exit(f'Existing post for {key}: {existing[0]} (migrate it before publishing)')
    print(mode+'\t'+str(source))
PY

TOTAL=${#RESOLVED[@]}
echo "Mode: $MODE | Notes: $TOTAL | $([[ "$WRITE" == true ]] && echo WRITE || echo PREVIEW)"
echo '--------------------------------------------------'
FAILED=0
SUCCEEDED=0
while IFS=$'\t' read -r operation source; do
  rel="${source#"$VAULT"/}"
  platform="${rel%%/*}"
  remainder="${rel#*/}"
  if [[ "$remainder" == */* ]]; then category="${remainder%%/*}"; else category=General; fi
  [[ -z "$OVERRIDE_PLATFORM" ]] || platform="$OVERRIDE_PLATFORM"
  [[ -z "$OVERRIDE_CATEGORY" ]] || category="$OVERRIDE_CATEGORY"
  args=("$operation" "$source" --platform "$platform" --category "$category")
  [[ -z "$OVERRIDE_TAGS" ]] || args+=(--tags "$OVERRIDE_TAGS")
  [[ "$WRITE" == false ]] || args+=(--write)
  printf '\n[%s] %s\n' "$operation" "$rel"
  if (cd "$REPO" && python3 "$PUBLISHER" "${args[@]}"); then
    ((SUCCEEDED+=1))
  else
    ((FAILED+=1))
    echo "FAILED: $rel" >&2
  fi
done < "$PLAN"
printf '\nSummary: %d succeeded, %d failed, %d total\n' "$SUCCEEDED" "$FAILED" "$TOTAL"
if [[ "$WRITE" == true ]]; then
  echo 'Local files only. Review git diff/status and content before committing or pushing.'
fi
((FAILED==0))
